# =============================================================================
# ⚙️ CẤU HÌNH CUPID AGENT MVP
# =============================================================================

# 📌 BƯỚC 1: CHỌN LLM PROVIDER ('auto' | 'openai' | 'gemini' | 'mock')
LLM_PROVIDER=auto

# 📌 BƯỚC 2: API KEYS (Tùy chọn. Nếu không có key, hệ thống chạy 100% Mock Mode)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 📌 BƯỚC 3: DATABASE CONFIGURATION
DATABASE_URL=sqlite:///./cupid_agent.db
